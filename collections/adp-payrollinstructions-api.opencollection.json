{
  "opencollection": "1.0.0",
  "info": {
    "name": "ADP Payroll Organizations PayrollInstructions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://accounts.adp.com/auth/oauth/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "PayrollInstructions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Payroll Instructions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.adp.com/payroll/v1/payroll-instructions"
          },
          "docs": "Retrieve pending payroll instructions and overrides for the next payroll run."
        },
        {
          "info": {
            "name": "Create Payroll Instruction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.adp.com/payroll/v1/payroll-instructions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a pay instruction (bonus, deduction override, garnishment) for an upcoming payroll run."
        }
      ]
    }
  ],
  "bundled": true
}